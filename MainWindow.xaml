<Window x:Class="WigetBus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WigetBus"
        Width="280" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

        <Border CornerRadius="12"
            Padding="8"
            Background="#FF222222"
            BorderBrush="#33444444"
            BorderThickness="1">

        <!-- škálování celého widgetu -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform"
                            ScaleX="1.0"
                            ScaleY="1.0"/>
        </Border.LayoutTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- horní část -->
                <RowDefinition Height="*"/>
                <!-- rozbalovací část -->
            </Grid.RowDefinitions>

            <!-- HORNÍ ČÁST -->
            <StackPanel Grid.Row="0" Margin="0,0,0,2">

                <!-- čas + datum -->
                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ČAS -->
                    <TextBlock x:Name="TimeText"
                               Grid.Row="0"
                               Margin="4,0,0,0"
                               VerticalAlignment="Top"
                               FontSize="55"
                               FontWeight="Bold"
                               Foreground="Yellow"
                               HorizontalAlignment="Left"/>

                    <!-- DATUM (těsněji u času) -->
                    <TextBlock x:Name="DateText"
                               Grid.Row="1"
                               Margin="0,-6,0,0"
                               FontSize="22"
                               Foreground="#FF99CCFF"
                               HorizontalAlignment="Left"
                               TextAlignment="Left"/>

                    <!-- Zoom buttons placed inside header grid so they remain visible when details are collapsed -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="-2,-6,0,0"
                                Panel.ZIndex="200">
                        <StackPanel.Resources>
                            <Style x:Key="SmallSquareButtonStyle" TargetType="Button">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#FFDDDDDD" />
                                <Setter Property="Background" Value="#11000000" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#22000000" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#33000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>

                        <Button x:Name="ZoomInButton"
                                Style="{StaticResource SmallSquareButtonStyle}"
                                Content="+"
                                Click="ZoomIn_Click"
                                Focusable="False"
                                Opacity="0.9"/>

                        <Button x:Name="ZoomOutButton"
                                Style="{StaticResource SmallSquareButtonStyle}"
                                Content="−"
                                Click="ZoomOut_Click"
                                Focusable="False"
                                Margin="6,0,0,0"
                                Opacity="0.9"/>
                    </StackPanel>
                </Grid>

                <!-- SVÁTEK + ŠIPKA (těsně u data) -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="ToggleArrowText"
                               Text="▼"
                               FontSize="16"
                               Foreground="#FFDDDDDD"
                               Cursor="Hand"
                               Margin="0,0,4,0"
                               MouseLeftButtonDown="ToggleDetailsText_MouseLeftButtonDown"/>

                    <TextBlock Text="Svátek: "
                               FontSize="16"
                               Foreground="#FFDDDDDD"
                               VerticalAlignment="Center"
                               Visibility="{Binding HolidayVisibility}"/>

                    <TextBlock x:Name="NameDayText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="{Binding HolidayText}"
                               Foreground="{Binding HolidayBrush}"
                               Visibility="{Binding HolidayVisibility}"/>
                </StackPanel>

            </StackPanel>

            

            <!-- SPODNÍ ČÁST (rozbalovací) -->
            <Grid x:Name="DetailsPanel"
                  Grid.Row="1"
                  Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- zoom -->
                    <RowDefinition Height="Auto"/>
                    <!-- kalendář (auto height) -->
                    <RowDefinition Height="*"/>
                    <!-- notes + alarms (fill remaining) -->
                </Grid.RowDefinitions>

                <!-- Zoom controls relocated to top-left corner of the main bubble -->

                <!-- Kalendář (roztažený edge-to-edge, tmavé zdroje) -->
                <Border Grid.Row="1"
                        Background="#000000"
                        CornerRadius="0"
                        BorderBrush="#111111"
                        BorderThickness="0"
                        Margin="-8,-8,-8,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Calendar x:Name="CalendarControl"
                              Margin="0"
                              DisplayMode="Month"
                              IsTodayHighlighted="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#000000"
                              FontSize="14"
                              BorderBrush="#111111"
                              BorderThickness="0"
                              Loaded="CalendarControl_Loaded"
                              DisplayDateChanged="CalendarControl_DisplayDateChanged"
                              DisplayModeChanged="CalendarControl_DisplayModeChanged"
                              SelectedDatesChanged="CalendarControl_SelectedDatesChanged">

                        <Calendar.Resources>
                            <!-- Dark calendar day button: tighter spacing, black background, yellow weekdays by default -->
                            <Style TargetType="CalendarDayButton">
                                <Setter Property="Background" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CalendarDayButton">
                                            <Border x:Name="RootBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootBorder" Property="Background" Value="#111111"/>
                                                </Trigger>
                                                <Trigger Property="IsToday" Value="True">
                                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#44AAFF"/>
                                                    <Setter TargetName="RootBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RootBorder" Property="Background" Value="#2255AA"/>
                                                    <!-- keep Foreground from code-behind so holidays/weekday colors remain visible -->
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="CalendarItem">
                                <Setter Property="Background" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CalendarItem">
                                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Do not force Foreground here; day Foreground is controlled from code-behind -->
                            </Style>
                        </Calendar.Resources>

                    </Calendar>
                </Border>

                <!-- Poznámka + Budíky (společný kontejner) -->
                <StackPanel Grid.Row="2" Margin="0" Orientation="Vertical">
                    <TextBlock Text="Poznámka:"
                               Foreground="#FFDDDDDD"
                               FontSize="11"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NoteTextBox"
                                 Height="18"
                                 Width="120"
                                 Margin="0,2,4,2"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="False"
                                 VerticalContentAlignment="Center"
                                 FontSize="10"
                                 Background="#222222"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#555555"/>

                        <Button x:Name="SaveNoteButton"
                                Content="Uložit"
                                Width="65"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Click="SaveNoteButton_Click"
                                Background="#444444"
                                Foreground="#FFFFFF"
                                BorderBrush="#777777"/>
                    </StackPanel>
                    <TextBlock x:Name="NoteStatusText"
                               Margin="0,1,0,0"
                               FontSize="10"
                               Foreground="#FFBBBBBB"/>

                    <!-- Seznam poznámek -->
                    <ListBox x:Name="NotesListBox"
                             Margin="0,6,0,0"
                             Background="#222222"
                             Foreground="#FFFFFF"
                             BorderBrush="#333333"
                             FontSize="10"
                             Height="100"
                             SelectionChanged="NotesListBox_SelectionChanged"/>
                    <Button x:Name="DeleteNoteButton" Content="Smazat poznámku" Width="120" Height="18" Margin="0,6,0,0" Click="DeleteNoteButton_Click"/>

                    <!-- Budíky -->
                    <TextBlock Text="Budíky:" Foreground="#FFDDDDDD" FontSize="11" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBox x:Name="AlarmTimeBox"
                                 Width="55"
                                 Height="18"
                                 Text="07:00"
                                 FontSize="10"
                                 Background="#333333"
                                 Foreground="#FFFFFF"
                                 Margin="0,0,5,0"/>

                        <TextBox x:Name="AlarmLabelBox"
                                 Width="100"
                                 Height="18"
                                 Text="Vstávání"
                                 FontSize="10"
                                 Background="#333333"
                                 Foreground="#FFFFFF"
                                 Margin="0,0,5,0"/>

                        <DatePicker x:Name="AlarmDatePicker" Width="120" Height="18" Margin="6,0,5,0" SelectedDateFormat="Short"/>
                        <CheckBox x:Name="AlarmRepeatCheck" Content="Zvoni každý den" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="6,0,0,0" Checked="AlarmRepeatCheck_Checked" Unchecked="AlarmRepeatCheck_Unchecked"/>

                        <Button x:Name="AddAlarmButton"
                                Content="Přidat"
                                Width="65"
                                Height="18"
                                Padding="0"
                                FontSize="10"
                                Click="AddAlarmButton_Click"
                                Background="#444444"
                                Foreground="#FFFFFF"/>
                    </StackPanel>

                    <ListBox x:Name="AlarmListBox"
                             FontSize="10"
                             Background="#333333"
                             Foreground="#FFFFFF"
                             BorderBrush="#555555"
                             MouseDoubleClick="AlarmListBox_MouseDoubleClick"
                             MaxHeight="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeString}" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding Label}" Grid.Column="1" VerticalAlignment="Center" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Content="⚙" Width="22" Height="18" Margin="6,0,4,0" Click="EditAlarmButton_Click"/>
                                    <Button Grid.Column="3" Content="🗑" Width="22" Height="18" Click="DeleteAlarmButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="AlarmStatusText"
                               FontSize="10"
                               Foreground="#FFBBBBBB"
                               Margin="0,2,0,0"/>
                </StackPanel>

            

            </Grid>

        </Grid>
    </Border>
</Window>

