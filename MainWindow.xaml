<Window x:Class="WigetBus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WigetBus"
        Width="280" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

        <Border CornerRadius="12"
            Padding="8"
            Background="#FF222222"
            BorderBrush="#33444444"
            BorderThickness="1">

        <!-- škálování celého widgetu -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform"
                            ScaleX="1.0"
                            ScaleY="1.0"/>
        </Border.LayoutTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- horní část -->
                <RowDefinition Height="*"/>
                <!-- rozbalovací část -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- HORNÍ ČÁST -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="-6,-10,0,0">
                <Grid.Resources>
                    <Style x:Key="SmallSquareButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="16" />
                        <Setter Property="Height" Value="16" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="#FFDDDDDD" />
                        <Setter Property="Background" Value="#11000000" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22000000" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>

                <StackPanel
                            Orientation="Vertical"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Panel.ZIndex="200">
                    <Button x:Name="ZoomInButton"
                            Style="{StaticResource SmallSquareButtonStyle}"
                            Content="+"
                            Click="ZoomIn_Click"
                            Focusable="False"
                            Opacity="0.9"/>

                    <Button x:Name="ZoomOutButton"
                            Style="{StaticResource SmallSquareButtonStyle}"
                            Content="−"
                            Click="ZoomOut_Click"
                            Focusable="False"
                            Margin="0,2,0,0"
                            Opacity="0.9"/>
                </StackPanel>

                <StackPanel Margin="0,-4,0,0"
                            VerticalAlignment="Top">
                    <TextBlock x:Name="TimeText"
                               Margin="0,-6,24,0"
                               VerticalAlignment="Top"
                               FontSize="61"
                               FontWeight="Bold"
                               Foreground="Yellow"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                    <TextBlock x:Name="DateText"
                               Margin="10,-12,0,0"
                               FontSize="22"
                               Foreground="#FF99CCFF"
                               HorizontalAlignment="Left"
                               TextAlignment="Left"
                               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="10,-1,0,0"
                                HorizontalAlignment="Left"
                                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock x:Name="ToggleArrowText"
                                   Text="▼"
                                   FontSize="17"
                                   Foreground="#FFDDDDDD"
                                   Cursor="Hand"
                                   Margin="0,0,4,0"
                                   MouseLeftButtonDown="ToggleDetailsText_MouseLeftButtonDown"/>

                        <TextBlock Text="Svátek: "
                                   FontSize="17"
                                   Foreground="#FFDDDDDD"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HolidayVisibility}"/>

                        <TextBlock x:Name="NameDayText"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding HolidayText}"
                                   Foreground="{Binding HolidayBrush}"
                                   Visibility="{Binding HolidayVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            

            <!-- SPODNÍ ČÁST (rozbalovací) -->
            <Grid x:Name="DetailsPanel"
                  Grid.Row="1"
                  Grid.Column="0"
                  Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- zoom -->
                    <RowDefinition Height="Auto"/>
                    <!-- kalendář (auto height) -->
                    <RowDefinition Height="*"/>
                    <!-- notes + alarms (fill remaining) -->
                </Grid.RowDefinitions>

                <!-- Zoom controls relocated to top-left corner of the main bubble -->

                <!-- Kalendář (roztažený edge-to-edge, tmavé zdroje) -->
                <Border Grid.Row="1"
                        Background="#000000"
                        CornerRadius="0"
                        BorderBrush="#111111"
                        BorderThickness="0"
                        Margin="-28,8,-8,0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Viewbox Stretch="Fill"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
                        <Calendar x:Name="CalendarControl"
                                  Margin="0"
                                  Width="160"
                                  Height="210"
                                  DisplayMode="Month"
                                  IsTodayHighlighted="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#000000"
                                  Foreground="#FFFFFFFF"
                                  FontSize="14"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  FocusVisualStyle="{x:Null}"
                                  Focusable="False"
                                  KeyboardNavigation.IsTabStop="False"
                                  Loaded="CalendarControl_Loaded"
                                  DisplayDateChanged="CalendarControl_DisplayDateChanged"
                                  DisplayModeChanged="CalendarControl_DisplayModeChanged"
                                  SelectedDatesChanged="CalendarControl_SelectedDatesChanged">

                        <Calendar.Resources>
                            <!-- Dark calendar day button: tighter spacing, black background, yellow weekdays by default -->
                            <Style TargetType="CalendarDayButton">
                                <Setter Property="Background" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CalendarDayButton">
                                            <Border x:Name="RootBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootBorder" Property="Background" Value="#111111"/>
                                                </Trigger>
                                                <Trigger Property="IsToday" Value="True">
                                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="#44AAFF"/>
                                                    <Setter TargetName="RootBorder" Property="BorderThickness" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RootBorder" Property="Background" Value="#2255AA"/>
                                                    <!-- keep Foreground from code-behind so holidays/weekday colors remain visible -->
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#FF777777"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="CalendarItem">
                                <Setter Property="Background" Value="#000000"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CalendarItem">
                                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Do not force Foreground here; day Foreground is controlled from code-behind -->
                            </Style>

                            <Style TargetType="CalendarButton">
                                <Setter Property="Background" Value="#000000"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFD8B4FF"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </Calendar.Resources>

                        </Calendar>
                    </Viewbox>
                </Border>

            </Grid>

            <!-- PRAVÝ PANEL (rozbalovací) -->
            <StackPanel x:Name="SidePanel"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Margin="14,-6,0,0"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                <TextBlock Text="Poznámka:"
                           Foreground="#FFDDDDDD"
                           FontSize="12"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="86"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="NoteTextBox"
                             Grid.Column="0"
                             Height="24"
                             Margin="0,0,8,0"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Background="#222222"
                             Foreground="#FFFFFF"
                             BorderBrush="#555555"/>

                    <Button x:Name="SaveNoteButton"
                            Grid.Column="1"
                            Content="Uložit"
                            Height="24"
                            Padding="0"
                            FontSize="12"
                            Click="SaveNoteButton_Click"
                            Background="#444444"
                            Foreground="#FFFFFF"
                            BorderBrush="#777777"/>
                </Grid>

                <TextBlock x:Name="NoteStatusText"
                           Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="#FFBBBBBB"/>

                <ListBox x:Name="NotesListBox"
                         Margin="0,12,0,0"
                         Background="#222222"
                         Foreground="#FFFFFF"
                         BorderBrush="#333333"
                         FontSize="11"
                         Height="190"
                         SelectionChanged="NotesListBox_SelectionChanged"/>

                <Button x:Name="DeleteNoteButton"
                        Content="Smazat poznámku"
                        Width="140"
                        Height="26"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Click="DeleteNoteButton_Click"/>

                <TextBlock Text="Budíky:"
                           Foreground="#FFDDDDDD"
                           FontSize="12"
                           Margin="0,18,0,0"/>

                <WrapPanel Margin="0,4,0,2">
                    <TextBox x:Name="AlarmTimeBox"
                             Width="55"
                             Height="24"
                             Text="07:00"
                             FontSize="12"
                             Background="#333333"
                             Foreground="#FFFFFF"
                             Margin="0,0,6,6"/>

                    <TextBox x:Name="AlarmLabelBox"
                             Width="104"
                             Height="24"
                             Text="Vstávání"
                             FontSize="12"
                             Background="#333333"
                             Foreground="#FFFFFF"
                             Margin="0,0,6,6"/>

                    <DatePicker x:Name="AlarmDatePicker"
                                Width="118"
                                Height="24"
                                Margin="0,0,6,6"
                                SelectedDateFormat="Short"/>

                    <CheckBox x:Name="AlarmRepeatCheck"
                              Content="Zvoni každý den"
                              VerticalAlignment="Center"
                              Foreground="#FFFFFF"
                              Margin="0,0,6,6"
                              Checked="AlarmRepeatCheck_Checked"
                              Unchecked="AlarmRepeatCheck_Unchecked"/>

                    <Button x:Name="AddAlarmButton"
                            Content="Přidat"
                            Width="65"
                            Height="24"
                            Padding="0"
                            FontSize="12"
                            Click="AddAlarmButton_Click"
                            Background="#444444"
                            Foreground="#FFFFFF"/>
                </WrapPanel>

                <ListBox x:Name="AlarmListBox"
                         FontSize="11"
                         Background="#333333"
                         Foreground="#FFFFFF"
                         BorderBrush="#555555"
                         MouseDoubleClick="AlarmListBox_MouseDoubleClick"
                         MaxHeight="150">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeString}" Grid.Column="0" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding Label}" Grid.Column="1" VerticalAlignment="Center" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="⚙" Width="22" Height="18" Margin="6,0,4,0" Click="EditAlarmButton_Click"/>
                                <Button Grid.Column="3" Content="🗑" Width="22" Height="18" Click="DeleteAlarmButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="AlarmStatusText"
                           FontSize="10"
                           Foreground="#FFBBBBBB"
                           Margin="0,2,0,0"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>

